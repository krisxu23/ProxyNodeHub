<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ProxyNodeHub.Discover</RootNamespace>
    <AssemblyName>Discover</AssemblyName>
  </PropertyGroup>

  <!-- 只读引用：core 提供发现引擎与解析，web 提供 StateStore/SubscriptionExporter。 -->
  <ItemGroup>
    <ProjectReference Include="../../core/ProxyNodeHub.Core.csproj" />
    <ProjectReference Include="../../web/ProxyNodeHub.Web.csproj" />
  </ItemGroup>

</Project>
